      <table>
        <title>Drilldown Application ($tok_app_label$) Events</title>
        <search base="base_app_crash_search">
          <query>search application="$tok_dd_app$"
| eval Attached_Files=if(isnull(Attached_Files),if(isnull(Attached_Files_other),"NA",mvjoin(Attached_Files_other,"|")),if(isnull(Attached_Files_other),mvjoin(Attached_Files,"|"),mvjoin(Attached_Files,"|")."| Other: -".mvjoin(Attached_Files_other," - ")))
| eval Problem_Signature="P1: ".P1."|P2: ".P2."|P3: ".P3."|P4: ".P4."|P5: ".P5."|P6: ".P6."|P7: ".P7."|P8: ".P8."|P9: ".P9."|P10: ".P10."|Attached Files: ".Attached_Files
| eval Info="Time: ".strftime(_time,"%m/%d/%y %I:%M:%S %P")."|Host: ".host."|Event Name: ".Event_Name."|sourcetype: ".sourcetype."|Fault Bucket: ".fault_bucket."|Response: ".Response."|Cab ID: ".cab_id."|Report ID: ".Report_Id."|Report Status Code:".Report_Status
| table Info,Problem_Signature
| makemv delim="|" Problem_Signature
| makemv delim="|" Info</query>
