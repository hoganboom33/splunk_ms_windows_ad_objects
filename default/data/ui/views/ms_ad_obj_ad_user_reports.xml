            <set token="form.atok_msad_action">deleted</set>
            <set token="tok_action">deleted</set>
            <set token="tok_action_lbl">Deleted</set>
            <set token="nmb_res_type_input">4</set>
            <set token="fields_time_rep">domain,user,orig_cn,whenDeleted,userAccountControl_Details,userPrincipalName,distinguishedName</set>
            <unset token="show_pwd_old_rep"></unset>
            <unset token="tok_sel_obj"></unset>
            <unset token="tok_chg_trigger"></unset>
            <unset token="show_regular_rep"></unset>
            <unset token="show_changed_rep"></unset>
            <unset token="show_res_type_input"></unset>
            <unset token="show_action_input"></unset>
          </condition>
          <condition value="disabled_users">
            <unset token="tok_sel_obj"></unset>
            <unset token="tok_chg_trigger"></unset>
            <unset token="show_regular_rep"></unset>
            <unset token="show_changed_rep"></unset>
            <unset token="show_res_type_input"></unset>           
            <unset token="show_action_input"></unset>
            <unset token="show_dd_details"></unset>
            <unset token="show_admon_dd_details"></unset>
            <unset token="show_active_rep"></unset>
            <unset token="show_pwd_old_rep"></unset>
            <set token="tok_report_label">$label$</set>
            <set token="tok_time_trigger">True</set>
            <set token="tok_time_label">Disabled Users</set>
            <set token="tok_report">| `ms_obj_md_secrpt-disabled-users</set>
