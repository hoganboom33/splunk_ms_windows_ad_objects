        <search base="base_field_ext_calc">
          <query>search type="$tok_field_type$" value IN("$tok_field_value$")| stats count by stanza | sort 0 stanza | table stanza</query>
        </search>
      </input>
      <input type="dropdown" token="tok_field_title">
        <label>Select Title:</label>
        <choice value="*">All</choice>
        <default>*</default>
        <initialValue>*</initialValue>
        <fieldForLabel>title</fieldForLabel>
        <fieldForValue>title</fieldForValue>
        <search base="base_field_ext_calc">
          <query>search value IN("$tok_field_value$") type="$tok_field_type$" stanza="$tok_field_stanza$"| stats count by title | sort 0 title | table title</query>
        </search>
      </input>
      <input type="dropdown" token="tok_field_app_sharing">
        <label>Select App Sharing:</label>
        <choice value="*">All</choice>
        <default>*</default>
        <initialValue>*</initialValue>
        <fieldForLabel>app_sharing</fieldForLabel>
        <fieldForValue>app_sharing</fieldForValue>
        <search base="base_field_ext_calc">
          <query>search value IN("$tok_field_value$") title="$tok_field_title$" type="$tok_field_type$" stanza="$tok_field_stanza$"| stats count by app_sharing | sort 0 app_sharing | table app_sharing</query>
        </search>
      </input>
      <input type="dropdown" token="input_tok_field_name">
        <label>Select field:</label>
        <choice value="all">All</choice>
        <default>all</default>
        <initialValue>all</initialValue>
        <fieldForLabel>field_name</fieldForLabel>
