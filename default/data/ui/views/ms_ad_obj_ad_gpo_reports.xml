          <h4 style="font-size:15px;color:red;" id="rep_msg_p_dd_warn">Click to search for <b>All Admon Change</b> activities with GPO:</h4>
          <span style="font-size:15px;color:red;" id="rep_msg_p_dd_warn_time">
            <ul style="list-style: none;">
              <li>
                <b>GPO:</b> $tok_sel_obj_label$ ($tok_sel_obj$)</li>
              <li>
                <b>From:</b> $set_time_from$</li>
              <li>
                <b>To:</b> $set_time_to$</li>
            </ul>
          </span>
        </center>
      </html>
    </panel>
  </row>
