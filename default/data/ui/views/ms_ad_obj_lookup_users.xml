    <panel>
      <html>
        <style>
#input_obj_filt::after {content: '$tok_obj_filt_lbl$';font-style: italic !important;font-size: 10px !important;color:$tok_obj_list_msg_color$ !important;display: inline-block;width: 100% !important;}
