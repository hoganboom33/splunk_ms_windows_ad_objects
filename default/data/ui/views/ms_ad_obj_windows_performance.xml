        <condition value="">
          <set token="PerfmonHostWildcard"></set>
        </condition>
        <condition>
          <set token="PerfmonHostWildcard">| where match(host,"$value$")</set>
        </condition>
      </change>
    </input>
    <input type="time" token="PageTime" searchWhenChanged="true">
      <label></label>
      <default>
        <earliest>-4h@m</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
