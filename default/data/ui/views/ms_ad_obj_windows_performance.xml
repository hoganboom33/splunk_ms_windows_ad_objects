<form script="ms_ad_obj_html_token_setter.js" stylesheet="ms_ad_obj_gbl_tabs.css" version="1.1">
  <label>AD Objects - Windows Performance</label>
  <init>
    <set token="tok_tab_1">active</set>
    <set token="tok_cpu_count">0</set>
    <set token="tok_mem_count">0</set>
    <set token="tok_pdisk_count">0</set>
    <set token="tok_ldisk_count">0</set>
    <set token="tok_net_count">0</set>
    <set token="tok_sys_count">0</set>
    <set token="tok_proc_count">0</set>
  </init>
  <search id="base_perfmon_search">
    <query>`ms__obj_win_perfmon_index` (object="Processor" OR object="Memory" OR object="PhysicalDisk" OR object="LogicalDisk" OR object="Network Interface" OR object="System")
| fields _time,host,object,counter,instance,Value
| stats sparkline(avg(Value)) as Trend avg(Value) as Average, max(Value) as Peak, latest(Value) as Current, latest(_time) as "Last Updated" by host,counter,instance,object 
| convert ctime("Last Updated") 
| sort - Current 
| eval Average=round(Average, 2) 
| eval Peak=round(Peak, 2) 
| eval Current=round(Current, 2)
| table host,object,counter,instance,Trend,Average,Peak,Current,"Last Updated"</query>
    <earliest>$PageTime.earliest$</earliest>
    <latest>$PageTime.latest$</latest>
  </search>
  <search id="base_perfmon_search_process">
    <query>`ms__obj_win_perfmon_index` $PerfmonHost$ object="Process"
| fields _time,host,object,counter,instance,Value
| stats sparkline(avg(Value)) as Trend avg(Value) as Average, max(Value) as Peak, latest(Value) as Current, latest(_time) as "Last Updated" by host,counter,instance,object 
| convert ctime("Last Updated") 
| sort - Current 
| eval Average=round(Average, 2) 
| eval Peak=round(Peak, 2)
| eval Current=round(Current, 2)
| table host,object,counter,instance,Trend,Average,Peak,Current,"Last Updated"</query>
    <earliest>$PageTime.earliest$</earliest>
    <latest>$PageTime.latest$</latest>
  </search>
  <search base="base_perfmon_search" id="sub_perfmon_processor">
    <query>search object="Processor" $PerfmonHostWildcard$ $PerfmonHost$ 
| table host,object,counter,instance,Trend,Average,Peak,Current,"Last Updated"</query>
  </search>
  <search base="base_perfmon_search" id="sub_perfmon_memory">
    <query>search object="Memory" $PerfmonHostWildcard$ $PerfmonHost$ 
| table host,object,counter,Trend,Average,Peak,Current,"Last Updated"</query>
  </search>
  <search base="base_perfmon_search" id="sub_perfmon_pdisk">
    <query>search object="PhysicalDisk" $PerfmonHostWildcard$ $PerfmonHost$ 
| table host,object,counter,instance,Trend,Average,Peak,Current,"Last Updated"</query>
  </search>
  <search base="base_perfmon_search" id="sub_perfmon_ldisk">
