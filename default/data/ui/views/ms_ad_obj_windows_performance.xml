    <input type="multiselect" token="PerfmonHost" searchWhenChanged="true">
      <label>Perfmon Hosts</label>
      <choice value="*">All</choice>
      <search base="base_perfmon_search">
        <query>stats count by host | sort host</query>
      </search>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <default>*</default>
      <initialValue>*</initialValue>
      <prefix>(</prefix>
      <suffix>)</suffix>
      <valuePrefix>host="</valuePrefix>
      <valueSuffix>"</valueSuffix>
      <delimiter> OR  </delimiter>
    </input>
    <input id="input_host_filter_list" type="text" token="tok_host_filter_bs" searchWhenChanged="true">
      <label>Filter Host</label>
      <default></default>
      <initialValue></initialValue>
