<form script="customized_chart_preload.js,ms_ad_obj_html_token_setter.js" stylesheet="ms_ad_obj_gbl_tabs.css" version="1.1">
  <label>AD Objects - Group - Sub Search - Builder</label>
  <init>
    <set token="tok_group_label">Pending</set>
    <set token="tok_object_count">0</set>
  </init>
  <search id="base_domain_search">
    <query>| `ms_obj_domain_list`</query>
    <done>
      <condition match="$job.resultCount$ == 0">
        <unset token="show_inputs"></unset>
        <set token="show_domain_warn">True</set>
      </condition>
      <condition>
        <unset token="show_domain_warn"></unset>
        <set token="show_inputs">True</set>
      </condition>
    </done>
  </search>
  <search base="base_domain_search" id="dom_lkp_vals">
    <query>search domain="$tok_domain$"</query>
    <done>
      <condition match="$job.resultCount$ == 0">
        <set token="tok_user_lkp">AD_Obj_User</set>
        <set token="tok_group_lkp">AD_Obj_Group</set>
        <set token="tok_computer_lkp">AD_Obj_Computer</set>
        <set token="tok_kv_suffix"></set>
        <set token="tok_dc_val">*</set>
      </condition>
      <condition>
        <set token="tok_user_lkp">$result.user_lookup$</set>
        <set token="tok_group_lkp">$result.group_lookup$</set>
        <set token="tok_computer_lkp">$result.computer_lookup$</set>
        <set token="tok_kv_suffix">$result.kv_suffix$</set>
        <set token="tok_dc_val">$result.dc_val$</set>
      </condition>
    </done>
  </search>
  <search id="base_time_filt">
    <query>| makeresults
| eval t_filt_s ="$field1.earliest$", t_filt_e="$field1.latest$"
| eval t_filt_s_f=case(match(t_filt_s,"^\d+$"),t_filt_s,t_filt_s="",0,match(t_filt_s,"^(\-|\@)"),relative_time(now(),t_filt_s))
| eval t_filt_e_f=case(match(t_filt_e,"^\d+$"),t_filt_e,t_filt_e="",9999999999,match(t_filt_e,"^(\-|\@)"),relative_time(now(),t_filt_e),t_filt_e="now",now())
| eval t_filt_s_l=if(t_filt_s_f=0,"0",strftime(t_filt_s_f,"%m/%d/%y %I:%M %P"))
| eval t_filt_e_l=if(t_filt_e_f=9999999999,"All Time",strftime(t_filt_e_f,"%m/%d/%y %I:%M %P"))
| eval t_filt_full_l=if(t_filt_e_f=9999999999,"All Time","From: ".strftime(t_filt_s_f,"%m/%d/%y %I:%M %P")." To: ".strftime(t_filt_e_f,"%m/%d/%y %I:%M %P"))
| table t_filt_s_f, t_filt_s_l,t_filt_e_f, t_filt_e_l,t_filt_full_l</query>
    <progress>
      <condition>
        <set token="tok_filt_start">$result.t_filt_s_l$</set>
        <set token="tok_filt_end">$result.t_filt_e_l$</set>
        <set token="tok_filt_msg">$result.t_filt_full_l$</set>
      </condition>
    </progress>
  </search>
  <search id="base_ad_group_objects">
    <query>| inputlookup $tok_group_lkp$ where domain="$tok_domain$" AND membercount!="0" AND (cn="$tok_group_filter$" OR sAMAccountName="$tok_group_filter$")
| eval srt_field=case(isDeleted="TRUE" AND membercount="0",0,isDeleted="TRUE" AND membercount!="0",1,isDeleted="FALSE" AND membercount="0",2,isDeleted="FALSE" AND membercount!="0",3)
| eval cn=if(isDeleted="TRUE","Deleted- ".sAMAccountName." (".membercount.")",cn." (".membercount.")")
| fields cn,sAMAccountName,distinguishedName,member, groupType_Name, srt_field</query>
    <earliest>0</earliest>
    <latest></latest>
    <done>
      <set token="tok_object_count">0</set>
      <set token="tok_object_count_color">blue</set>
      <set token="tok_results_count">0</set>
      <set token="tok_results_count_color">blue</set>
      <set token="tok_group_list_search">| inputlookup $tok_group_lkp$ where domain="$tok_domain$"
| eval srt_field=case(isDeleted="TRUE" AND membercount="0",0,isDeleted="TRUE" AND membercount!="0",1,isDeleted="FALSE" AND membercount="0",2,isDeleted="FALSE" AND membercount!="0",3)
| eval cn=if(isDeleted="TRUE","Deleted- ".sAMAccountName." (".membercount.")",cn." (".membercount.")")
| fields cn,sAMAccountName,distinguishedName,member, groupType_Name, srt_field</set>
    </done>
    <done>
      <condition match=" 'job.resultCount' == 0">
        <set token="tok_show_no_group_s_err"></set>
      </condition>
      <condition>
        <set token="tok_show_no_group_s_err">display:none;</set>
      </condition>
    </done>
  </search>
  <search id="base_object_list">
    <query>| inputlookup $tok_user_lkp$ WHERE domain=$tok_domain$ [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| append [| inputlookup $tok_computer_lkp$ WHERE domain=$tok_domain$ [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn| table dn | format]| table *]
| append [| inputlookup $tok_group_lkp$ WHERE domain=$tok_domain$ [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]| table *]
| eval obj_type_val=case(objectClass=="top|person|organizationalPerson|user","user",objectClass=="top|person|organizationalPerson|user|computer","computer",objectClass=="top|group","group")
| fields *</query>
    <earliest>0</earliest>
    <latest></latest>
    <done>
      <set token="tok_srch_obj_list">| inputlookup $tok_user_lkp$ WHERE domain=$tok_domain$ [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| append [| inputlookup $tok_computer_lkp$ WHERE domain=$tok_domain$ [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn| table dn | format]| table *]
| append [| inputlookup $tok_group_lkp$ WHERE domain=$tok_domain$ [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]| table *]
| eval obj_type_val=case(objectClass=="top|person|organizationalPerson|user","user",objectClass=="top|person|organizationalPerson|user|computer","computer",objectClass=="top|group","group")
| fields *</set>
    </done>
    <done>
      <condition match=" 'job.resultCount' == 0">
        <set token="tok_group_user_list">0</set>
        <set token="tok_no_objects_found">True</set>
        <set token="tok_object_count">0</set>
        <set token="tok_object_count_color">red</set>
        <set token="tok_show_no_member_s_err"></set>
      </condition>
      <condition>
        <set token="tok_object_count">$job.resultCount$</set>
        <set token="tok_object_count_color">green</set>
        <set token="tok_show_no_member_s_err">display:none;</set>
        <unset token="tok_no_objects_found"></unset>
      </condition>
    </done>
  </search>
  <search id="sub_rex_filter" base="base_object_list">
    <query>stats values($tok_source_link_field$) AS tgt_filt | eval tgt_filt=mvjoin(tgt_filt,"|") | table tgt_filt
    </query>
    <done>
      <set token="tok_tgt_filt">$result.tgt_filt$</set>
    </done>
    <done>
      <condition match=" 'job.resultCount' == 0">
        <set token="tok_object_found">True</set>
      </condition>
    </done>
  </search>
  <search id="base_object_filter" base="base_object_list">
    <query>search obj_type_val="$tok_member_obj_type$"
| stats values($tok_source_link_field$) AS search
| $tok_target_object_link_field_filt$
| table search
| format</query>
    <done>
      <condition match=" 'job.resultCount' == 0">
        <set token="tok_filter"></set>
      </condition>
      <condition>
        <set token="tok_filter">$result.search$</set>
        <set token="tok_obj_filt_srch">| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| stats values($tok_source_link_field$) AS search
| $tok_target_object_link_field_filt$
| table search
| format</set>
      </condition>
    </done>
  </search>
  <search id="base_built_search">
    <query>$tok_filter_text$ $tok_index_filt$ $tok_sourcetype_filt$  ([| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| fields $tok_source_link_field$
| stats values($tok_source_link_field$) AS $tok_target_link_field_filt$
| table $tok_target_link_field_filt$
| format])
| fields $tok_target_link_field_list$
</query>
    <earliest>$field1.earliest$</earliest>
    <latest>$field1.latest$</latest>
    <progress>
      <condition>
        <eval token="tok_results_count">$job.dispatchState$." ".toString($job.eventCount$,"commas")</eval>
        <set token="tok_obj_full_srch">$tok_filter_text$ $tok_index_filt$ $tok_sourcetype_filt$  ([| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup AD_Obj_Group WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| fields $tok_source_link_field$
| stats values($tok_source_link_field$) AS $tok_target_link_field_filt$
| table $tok_target_link_field_filt$
| format])
| fields $tok_target_link_field_list$</set>
        <set token="tok_results_count_color">blue</set>
        <set token="tok_obj_filt_srch">| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| stats values($tok_source_link_field$) AS search
| $tok_target_object_link_field_filt$
| table search
| format</set>
      </condition>
    </progress>
    <done>
      <condition match=" 'job.resultCount' == 0">
        <set token="tok_results_count">0</set>
        <set token="tok_results_count_color">red</set>
        <unset token="tok_user_drilldown"></unset>
        <unset token="tok_user_drilldown_label"></unset>
        <set token="tok_show_no_event_s_err"></set>
      </condition>
      <condition>
        <eval token="tok_results_count">toString($job.eventCount$,"commas")</eval>
        <set token="tok_results_count_color">green</set>
        <set token="tok_user_drilldown">*</set>
        <set token="tok_user_drilldown_label">All Results</set>
        <set token="tok_show_no_event_s_err">display:none;</set>
      </condition>
    </done>
  </search>
  <!--row id="tab_results">
    <panel depends="$tok_sourcetype$">
      <event>
        <title>Resulting Events - Total Events ($tok_results_count$)</title>
        <search base="base_built_search">
          <query></query>
        </search>
      </event>
    </panel>
  </row-->
  <fieldset submitButton="true">
    <html>
      <p style="font-size:8;">
        <b>
          <i> <font color="red">Step 1</font>: Selected Domain, Group Type, Group, Member Object Type and Object's Source Field for building the base search text.  The Field selected with the <font color="green">Select Source Link Field</font> will contain the values that will be returned in the sub-search and used to filter the configured target data:</i>
        </b>
      </p>
	</html>
    <input type="dropdown" token="input_tok_domain" searchWhenChanged="true">
      <label>1.1 Select Group Domain</label>
      <choice value="sel">Select Domain</choice>
      <search base="base_domain_search">
        <query>table domain | sort domain</query>
      </search>
      <fieldForLabel>domain</fieldForLabel>
      <fieldForValue>domain</fieldForValue>
      <default>sel</default>
      <initialValue>sel</initialValue>
      <change>
        <condition value="sel">
          <unset token="tok_domain"></unset>
          <unset token="tok_show_group_filter"></unset>
        </condition>
        <condition>
          <set token="tok_domain">$value$</set>
          <set token="tok_show_group_filter">True</set>
        </condition>
      </change>
    </input>
    <input type="text" token="input_group_filter_bs" searchWhenChanged="true" depends="$tok_show_group_filter$">
      <label>1.2 Filter Domain Groups</label>
      <initialValue></initialValue>
      <change>
        <condition match="len($value$)>0">
          <set token="tok_group_filter">$value$</set>
          <set token="tok_show_group">True</set>
        </condition>
        <condition>
          <unset token="tok_show_group"></unset>
        </condition>
      </change>
    </input>
    <input type="dropdown" token="tok_group_type" searchWhenChanged="true" depends="$tok_show_group$">
      <label>1.3 Select Group Type</label>
      <choice value="*">All</choice>
      <search base="base_ad_group_objects">
        <query>stats count by groupType_Name | sort groupType_Name</query>
      </search>
      <fieldForLabel>groupType_Name</fieldForLabel>
      <fieldForValue>groupType_Name</fieldForValue>
      <default>*</default>
      <initialValue>*</initialValue>
    </input>
    <input type="dropdown" token="tok_group" searchWhenChanged="true" depends="$tok_show_group$">
      <label>1.4 Select Group(Member Count)</label>
      <search base="base_ad_group_objects">
        <query>search groupType_Name="$tok_group_type$" 
| stats count by sAMAccountName, cn,distinguishedName, srt_field 
| sort -srt_field, sAMAccountName 
| table cn, distinguishedName</query>
      </search>
      <fieldForLabel>cn</fieldForLabel>
      <fieldForValue>distinguishedName</fieldForValue>
      <change>
        <set token="tok_audit_value">$value$</set>
        <set token="tok_group_label">$label$</set>
      </change>
    </input>
    <input type="radio" token="input_tok_member_obj_type" depends="$tok_group$" id="sel_member_type">
      <label>1.5 Select Member Type</label>
      <fieldForLabel>obj_type_label</fieldForLabel>
      <fieldForValue>obj_type_val</fieldForValue>
      <search base="base_object_list" id="sub_src_obj_type_list">
        <query>fields obj_type_val
| stats count by obj_type_val
| eval obj_type_label=case(obj_type_val=="user","( ".count." ) User",obj_type_val=="computer","( ".count." ) Computer",obj_type_val=="group","( ".count." ) Group")
| table obj_type_val,obj_type_label
| sort -obj_type_val</query>
      </search>
      <change>
        <condition value="user">
          <set token="tok_member_obj_type">user</set>
          <set token="tok_member_obj_lkp">$tok_user_lkp$</set>
          <set token="tok_member_obj_type_label">User</set>
        </condition>
        <condition value="computer">
          <set token="tok_member_obj_type">computer</set>
          <set token="tok_member_obj_lkp">$tok_computer_lkp$</set>
          <set token="tok_member_obj_type_label">Computer</set>
        </condition>
        <condition value="group">
          <set token="tok_member_obj_type">group</set>
          <set token="tok_member_obj_lkp">$tok_group_lkp$</set>
          <set token="tok_member_obj_type_label">Embedded Group</set>
        </condition>
        <condition>
          <unset token="tok_member_obj_type"></unset>
        </condition>
      </change>
    </input>
    <input type="dropdown" token="input_source_user_link_field" searchWhenChanged="true" depends="$tok_group$,$tok_member_obj_type$">
      <label>1.6 Select $tok_member_obj_type_label$ Link Field</label>
      <choice value="start">Select Field</choice>
      <default>start</default>
      <initialValue>start</initialValue>
      <search base="base_object_list" id="sub_source_user_field_list">
        <query>search obj_type_val="$tok_member_obj_type$" 
| head 10
| fieldsummary
| search count&gt;0 NOT(field=sourcetype OR field=index OR field=tag* OR field=source OR field=eventtype OR field=splunk_server OR field=date_*)
| table field, values 
| fields + field, values
| rex max_match=2 field=values "\{\"value\"\:\"(?P&lt;Example_Values&gt;[\S\-\S][^\"]+)"
| search Example_Values="*"
| stats values(Example_Values) AS Example_Values by field
| table field,Example_Values
| sort field</query>
      </search>
      <fieldForLabel>field</fieldForLabel>
      <fieldForValue>field</fieldForValue>
      <change>
        <condition value="start">
          <unset token="tok_object_found"></unset>
          <unset token="tok_source_link_field"></unset>
        </condition>
        <condition>
          <set token="tok_source_link_field">$value$</set>
          <set token="tok_object_found">$value$</set>
          <set token="tok_tab_1">active</set>
        </condition>
      </change>
    </input>
    <html depends="$tok_group$,$tok_object_found$">
      <!--HR WIDTH="75%" SIZE="1"/-->
      <p style="font-size:8;">
        <b>
          <i> <font color="red">Step 2</font>: Select Target data to correllate the above selected Group's members ($tok_source_link_field$) with:</i>
        </b>
      </p>
	</html>
    <input type="time" token="field1" searchWhenChanged="true" depends="$tok_group$,$tok_object_found$">
      <label>2.1 Select Time Range</label>
      <default>
        <earliest>-4h@m</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="tok_index" searchWhenChanged="true" depends="$tok_group$,$tok_object_found$">
      <label>2.2 Select Base Search index</label>
      <choice value="all">All</choice>
      <default></default>
      <initialValue></initialValue>
      <search>
        <query>| eventcount summarize=false index=* | search count&gt;0 NOT index=_* NOT index=history NOT index=summary | dedup index | fields index| sort index</query>
        <earliest>-24h</earliest>
        <latest>now</latest>
      </search>
      <fieldForLabel>index</fieldForLabel>
      <fieldForValue>index</fieldForValue>
      <change>
        <condition value="">
          <unset token="tok_show_sourcetype"></unset>
          <unset token="tok_index_filt"></unset>
          <unset token="tok_target_link_field"></unset>
          <unset token="tok_user_drilldown"></unset>
          <unset token="tok_base_srch_msg"></unset>
          <set token="form.tok_sourcetype"></set>
        </condition>
        <condition value="all">
          <set token="tok_show_sourcetype">True</set>
          <set token="tok_index_filt"></set>
          <set token="tok_base_srch_msg">No Target Data specified for (index, sourcetype, or extra text), so sub-search filter values will search across all indexed data.</set>
          <set token="tok_base_srch_color">Orange</set>
          <set token="form.tok_sourcetype"></set>
          <unset token="tok_user_drilldown"></unset>
        </condition>
        <condition>
          <set token="tok_show_sourcetype">True</set>
          <set token="tok_index_filt">index="$value$"</set>
          <set token="form.tok_sourcetype"></set>
          <set token="tok_base_srch_msg">index="$value$" $tok_filter_text$</set>
          <set token="tok_base_srch_color">blue</set>
          <unset token="tok_user_drilldown"></unset>
        </condition>
      </change>
    </input>
    <input type="dropdown" token="tok_sourcetype" searchWhenChanged="true" depends="$tok_group$,$tok_object_found$,$tok_show_sourcetype$">
      <label>2.3 Select Base Search sourcetype</label>
      <default></default>
      <initialValue></initialValue>
      <search>
        <query>| metadata type=sourcetypes $tok_index_filt$ | dedup sourcetype | table sourcetype</query>
      </search>
      <choice value="all">All</choice>
      <fieldForLabel>sourcetype</fieldForLabel>
      <fieldForValue>sourcetype</fieldForValue>
      <change>
        <condition value="">
          <unset token="tok_show_field_list"></unset>
          <unset token="tok_sourcetype_filt"></unset>
          <unset token="tok_user_drilldown"></unset>
        </condition>
        <condition value="all">
          <set token="tok_show_field_list">True</set>
          <set token="tok_sourcetype_filt"></set>
          <unset token="tok_user_drilldown"></unset>
        </condition>
        <condition>
          <set token="tok_show_field_list">True</set>
          <set token="tok_sourcetype_filt">sourcetype="$value$"</set>
          <set token="tok_base_srch_msg">$tok_index_filt$ sourcetype="$value$" $tok_filter_text$</set>
          <set token="tok_base_srch_color">blue</set>
          <unset token="tok_user_drilldown"></unset>
        </condition>
      </change>
    </input>
    <input type="dropdown" token="tok_target_link_field" searchWhenChanged="true" depends="$tok_group$,$tok_object_found$,$tok_show_field_list$">
      <label>2.4 Select Target Link Field</label>
      <choice value="search">(Raw Text Search)</choice>
      <default></default>
      <initialValue></initialValue>
      <search id="base_field_list">
        <query>$tok_index_filt$ $tok_sourcetype_filt$  
	([| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
	| fields $tok_source_link_field$
	| stats values($tok_source_link_field$) AS search
	| eval search="\"".mvjoin(search,"\" OR \"")."\""
	| table search])
| head 10
| fieldsummary
| search count&gt;0 NOT(field=sourcetype OR field=index OR field=tag* OR field=source OR field=eventtype OR field=splunk_server OR field=date_*)
| table field, values 
| fields + field, values
| rex max_match=2 field=values "\{\"value\"\:\"(?P&lt;Example_Values&gt;[\S\-\S][^\"]+)"
| search Example_Values="*"
| stats values(Example_Values) AS Example_Values by field
| table field,Example_Values
| sort field</query>
      </search>
      <fieldForLabel>field</fieldForLabel>
      <fieldForValue>field</fieldForValue>
      <change>
        <condition value="">
          <unset token="tok_target_link_field_list"></unset>
          <unset token="tok_target_link_field_label"></unset>
          <unset token="tok_target_link_field_filt"></unset>
          <unset token="tok_target_results_drilldown"></unset>
          <unset token="tok_user_drilldown"></unset>
          <unset token="tok_results_raw"></unset>
          <unset token="tok_results_non_raw"></unset>
        </condition>
        <condition value="search">
          <set token="tok_target_link_field_list">_time,host,sourcetype,_raw</set>
          <set token="tok_target_link_field_label">_raw</set>
          <set token="tok_results_raw">true</set>
          <unset token="tok_results_non_raw"></unset>
          <set token="tok_target_results_drilldown"></set>
          <set token="tok_target_link_field_filt">search</set>
          <set token="tok_filtered_srch_url">$tok_filter_text$ $tok_index_filt$ $tok_sourcetype_filt$ $tok_filter_text$ 
([| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| fields $tok_source_link_field$
| stats values($tok_source_link_field$) AS search
| table search
| format])</set>
          <set token="tok_sub_srch_url">| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| fields $tok_source_link_field$
| stats values($tok_source_link_field$) AS search
| table search
| format</set>
        </condition>
        <condition>
    	  <set token="tok_target_link_field_list">_time,host,sourcetype,_raw,$value$</set>
          <set token="tok_results_non_raw">true</set>
          <unset token="tok_results_raw"></unset>
          <set token="tok_target_link_field_label">$value$</set>
          <set token="tok_target_results_drilldown">$value$=</set>
          <set token="tok_target_link_field_filt">$value$</set>
          <set token="tok_filtered_srch_url">$tok_filter_text$ $tok_index_filt$ $tok_sourcetype_filt$  
	([| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
	| fields $tok_source_link_field$
	| stats values($tok_source_link_field$) AS $value$
	| table $value$
	| format])</set>
          <set token="tok_sub_srch_url">| inputlookup $tok_member_obj_lkp$ WHERE domain=$tok_domain$ AND [| inputlookup $tok_group_lkp$ WHERE dn="$tok_group$" | fields member | rename member as dn | table dn | format]
| fields $tok_source_link_field$
| stats values($tok_source_link_field$) AS $value$
| table $value$
| format</set>
        </condition>
      </change>
    </input>
    <input type="text" token="input_tok_filter_text" searchWhenChanged="true" depends="$tok_group$,$tok_object_found$,$tok_show_field_list$">
