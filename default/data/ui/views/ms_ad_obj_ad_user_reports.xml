            <set token="fields_time_rep">domain,user,whenChanged,userAccountControl,userAccountControl_Details,userPrincipalName,distinguishedName</set>
          </condition>
          <condition value="smartcard_required">
            <unset token="show_dd_details"></unset>
            <unset token="show_admon_dd_details"></unset>
            <unset token="show_active_rep"></unset>
            <unset token="show_pwd_old_rep"></unset>
