<form script="ms_ad_obj_html_token_setter.js" stylesheet="ms_ad_obj_gbl_tabs.css" hideFilters="True" version="1.1">
  <label>AD Objects - Windows App - Crashes</label>
  <init>
    <set token="tok_tab_1">active</set>
    <set token="tok_tab_c_1">active</set>
  </init>
  <search base="base_app_crash_search" id="sub_c_search">
    <query>search host="$tok_c_host$" app_file="$tok_c_app_file$"
| eval app_file_wo_ext=replace(app_file,"\.exe","")
| stats values(Report_Id) AS report_ids, values(app_file) AS app_files,values(app_file_wo_ext) AS app_files_wo_ext
| eval report_ids="(".mvjoin(report_ids," OR ").")",app_files="(".mvjoin(app_files," OR ").")",app_files_wo_ext="(".mvjoin(app_files_wo_ext," OR ").")"
| eval correlate_filt=if(isnull(report_ids),if(isnull(app_files),"NA",app_files),if(isnull(app_files),report_ids,app_files." OR ".report_ids))</query>
    <progress>
      <eval token="tok_c_filt">if($result.correlate_filt$=="NA",NULL,$result.correlate_filt$)</eval>
      <eval token="tok_c_app_files">if(isnull($result.app_files$),NULL,$result.app_files$)</eval>
      <eval token="tok_c_app_files_wo_ext">if(isnull($result.app_files_wo_ext$),NULL,$result.app_files_wo_ext$)</eval>
      <eval token="tok_c_app_files_label">if(isnull($result.app_files_wo_ext$),"No Application Files Found for selected Host.","No Perfmon (object=Process) for instances ".$result.app_files_wo_ext$." found.")</eval>
    </progress>
  </search>
  <search id="base_c_perfmon_search">
    <query>`ms__obj_win_perfmon_index` $tok_c_app_files_wo_ext$  host="$tok_c_host$" object="Process"
| fields _time,host,instance,counter,Value
| stats sparkline(avg(Value)) as Trend avg(Value) as Average, max(Value) as Peak, latest(Value) as Current, latest(_time) as "Last Updated" by host,counter,instance 
| convert ctime("Last Updated") 
| sort - Current
| rename instance AS Process
| table host,counter,Process,Trend,Average,Peak,Current,"Last Updated" 
</query>
    <earliest>$Time.earliest$</earliest>
    <latest>$Time.latest$</latest>
    <done>
      <condition match=" 'job.resultCount' == 0">
        <set token="tok_show_c_perfm_msg">True</set>
        <unset token="tok_show_c_perfm"></unset>
      </condition>
      <condition>
        <set token="tok_show_c_perfm">True</set>
        <unset token="tok_show_c_perfm_msg"></unset>
      </condition>
    </done>
  </search>
  <search id="base_app_crash_search">
    <query>`ms_obj_win_events_application` EventCode="1001"  "Windows Error Reporting"
| fields _time,_raw,sourcetype,host,Event_Name,Report_Status,Report_Id,fault_bucket,Attached_Files,Response,Cab_Id,P1,P2,P3,P4,P5,P6,P7,P8,P9,P10
| rex max_match=0 "(?:\&lt;EventData\&gt;)\&lt;Data\&gt;\&lt;\/Data\&gt;\&lt;Data\&gt;(?&lt;fault_bucket&gt;[^\&lt;]+)\&lt;\/Data\&gt;\&lt;Data\&gt;(?&lt;Event_Name&gt;[^\&lt;]+)\&lt;\/Data\&gt;\&lt;Data\&gt;(?&lt;Response&gt;[^\&lt;]+)\&lt;\/Data\&gt;\&lt;Data\&gt;(?&lt;Cab_Id&gt;[^\&lt;]+)\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P1&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P2&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P3&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P4&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P5&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P6&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P7&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P8&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P9&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;P10&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;Attached_Files&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;Attached_Files_other&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;Analysis_symbol&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;Solution_recheck&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;Report_Id&gt;[^\&lt;]+))\&lt;\/Data\&gt;\&lt;Data\&gt;(|(?&lt;Report_Status&gt;[^\&lt;]+))\&lt;\/Data\&gt;"
| fillnull value="NA" P1,P2,P3,P4,P5,P6,P7,P8,P9,P10,fault_bucket,cab_id,Report_Id,Report_Status,Response
| eval application=if(Event_Name=="APPCRASH",P1." (version: ".P2.")",Event_Name),app_file=if(Event_Name=="APPCRASH",P1,if(match(Event_Name,"WindowsUpdateFailure"),"Wuauclt.exe",NULL))
| table _time,_raw,sourcetype,host,application,Event_Name,P1,P2,P3,P4,P5,P6,P7,P8,P9,P10,fault_bucket,cab_id,Report_Id,Report_Status,Response,Attached_Files,Attached_Files_other,app_file</query>
    <earliest>$Time.earliest$</earliest>
    <latest>$Time.latest$</latest>
  </search>
  <fieldset submitButton="false" autoRun="true">
    <input type="dropdown" token="EventHost" searchWhenChanged="true">
      <label>Event Host</label>
      <choice value="*">All</choice>
      <search base="base_app_crash_search">
        <query>search  application="$tok_app$" Event_Name="$tok_event_name$"
| fields host
| stats count by host
| sort host</query>
      </search>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <default>*</default>
    </input>
    <input type="dropdown" token="tok_app_bs">
      <label>Select Application</label>
      <choice value="all">All</choice>
      <fieldForLabel>application</fieldForLabel>
      <fieldForValue>application</fieldForValue>
      <search base="base_app_crash_search">
        <query>search host="$EventHost$" Event_Name="$tok_event_name$"
| stats count by application
| sort application</query>
      </search>
      <change>
        <condition value="all">
          <set token="tok_app">*</set>
          <set token="tok_app_label">All Applications</set>
          <unset token="tok_dd_app"></unset>
        </condition>
        <condition>
          <set token="tok_app">$value$</set>
          <set token="tok_app_label">$value$</set>
          <set token="tok_dd_app">$value$</set>
        </condition>
      </change>
      <default>all</default>
      <initialValue>all</initialValue>
    </input>
    <input type="dropdown" token="tok_event_name_bs" searchWhenChanged="true">
      <label>Select Event_Name</label>
      <choice value="all">All</choice>
      <fieldForLabel>Event_Name</fieldForLabel>
      <fieldForValue>Event_Name</fieldForValue>
      <search base="base_app_crash_search">
        <query>search host="$EventHost$" application="$tok_app$"
| stats count by Event_Name
| sort Event_Name</query>
      </search>
      <change>
        <condition value="all">
          <set token="tok_event_name">*</set>
          <set token="tok_event_name_label">All Event_Namess</set>
        </condition>
        <condition>
          <set token="tok_event_name">$value$</set>
          <set token="tok_event_name_label">$value$</set>
        </condition>
      </change>
      <default>all</default>
      <initialValue>all</initialValue>
    </input>
    <input type="time" token="Time">
      <label></label>
      <default>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
