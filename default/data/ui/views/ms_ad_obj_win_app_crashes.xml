      <html><h3>Windows Event Log Correlated Search</h3> <details ontoggle="mydetfunction()"><summary><i class="icon-search"> (View Search) - </i></summary>
		          <pre>(sourcetype="WinEventLog" OR sourcetype="XmlWinEventLog") host="$tok_c_host$" $tok_c_filt$</pre>
		     </details></html>
      <event>
