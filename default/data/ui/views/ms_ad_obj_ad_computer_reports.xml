            <set token="tok_chg_cmp_filt"></set>
            <set token="tok_action">deleted</set>
            <set token="tok_action_lbl">Deleted</set>
            <set token="nmb_res_type_input">4</set>
            <set token="fields_time_rep">orig_cn,cn,sAMAccountName,dNSHostName,whenDeleted,uac_details, userAccountControl,operatingSystem,operatingSystemServicePack</set>
            <set token="tok_res_message">4. Select Event Result Type</set>
