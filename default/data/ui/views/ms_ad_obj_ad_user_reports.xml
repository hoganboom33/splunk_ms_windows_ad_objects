            <unset token="tok_sel_obj"></unset>
            <set token="show_active_msg">True</set>
            <set token="show_message">True</set>
            <set token="tok_message_color">green</set>
            <set token="tok_message_state">Info:</set>
            <set token="tok_message">4. Enter Days Back for Last Login</set>
            <unset token="show_regular_rep"></unset>
            <unset token="show_pwd_old_rep"></unset>
            <unset token="tok_chg_trigger"></unset>
            <unset token="show_changed_rep"></unset>
            <unset token="show_res_type_input"></unset>
            <unset token="show_action_input"></unset>
          </condition>
          <condition value="inactive_users">
            <unset token="show_dd_details"></unset>
            <unset token="show_admon_dd_details"></unset>
            <unset token="show_time_input"></unset>
            <set token="tok_report_label">$label$</set>
            <set token="show_active_rep">True</set>
            <set token="show_active_msg">True</set>
            <set token="tok_active_label">Enter Days Since Last Login</set>
            <set token="show_message">True</set>
            <set token="tok_message_color">green</set>
            <set token="tok_message_state">Info:</set>
            <set token="tok_message">4. Enter Days Since Last Login</set>
            <unset token="show_regular_rep"></unset>
            <unset token="show_pwd_old_rep"></unset>
            <unset token="tok_chg_trigger"></unset>
            <unset token="tok_sel_obj"></unset>
            <unset token="show_time_input"></unset>
            <unset token="show_time_rep"></unset>
            <unset token="show_changed_rep"></unset>
            <unset token="show_res_type_input"></unset>
            <unset token="show_action_input"></unset>
          </condition>
          <condition value="unused_users">
            <set token="tok_report_label">$label$</set>
            <set token="show_regular_rep">True</set>
            <set token="tok_report">|`ms_obj_md_secrpt-unused-users($tok_user_lkp$,$tok_domain$)`</set>
            <unset token="tok_chg_trigger"></unset>
            <unset token="show_pwd_old_rep"></unset>
            <unset token="tok_sel_obj"></unset>
            <unset token="show_action_input"></unset>
