  <row depends="$tok_tab_4$,$tok_tab_c_2$">
    <panel>
      <html>
        <h3>Performance Counter Correlated Search</h3>
          <details ontoggle="mydetfunction()"><summary><i class="icon-search"> (View Search) - </i></summary>
		          <pre>index=perfmon $tok_c_app_files_wo_ext$  host="$tok_c_host$" object="Process"
| fields _time,host,instance,counter,Value
| stats sparkline(avg(Value)) as Trend avg(Value) as Average, max(Value) as Peak, latest(Value) as Current, latest(_time) as "Last Updated" by host,counter,instance 
| convert ctime("Last Updated") 
| sort - Current
| rename instance AS Process
| table host,counter,Process,Trend,Average,Peak,Current,"Last Updated"
| search Process="$tok_c_perf_process$" counter="$tok_c_perf_counter$"</pre>
		     </details></html>
      <table depends="$tok_show_c_perfm$">
        <title>Performance Counter Correlated Search $tok_c_app_files_wo_ext$</title>
        <search base="base_c_perfmon_search">
