  <row id="tabs_sub_row" depends="$tok_tab_4$">
    <panel>
      <html>
        <ul id="tabs" class="nav nav-tabs">
          <li class="$tok_tab_c_1$">
            <a href="#tab_uc_def" class="toggle-tab" data-token-json="{&quot;tok_tab_c_1&quot;:&quot;active&quot;,&quot;tok_tab_c_2&quot;:&quot;undefined&quot;}">Correlated Windows Events</a>
